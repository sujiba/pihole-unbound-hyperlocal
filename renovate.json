{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pi-hole base image version in docker-bake.hcl",
      "managerFilePatterns": ["/^docker-build/docker-bake\\.hcl$/"],
      "matchStrings": [
        "variable \"VERSION\"\\s*\\{\\s*default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "ghcr.io/pi-hole/pihole",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["ghcr.io/pi-hole/pihole"],
      "commitMessageTopic": "Pi-hole"
    }
  ]
}